{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "comment": "Package manager is Bun (see bun.lock). Do not add an npm/yarn/pnpm lockfile — CI, husky and the preview all use bun.",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.js",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --outfile=server.js --external:vite --external:express --external:helmet --external:express-rate-limit --external:dotenv --external:@google/genai",
    "preview": "bun run build && PORT=4173 node server.js",
    "clean": "rm -rf dist server.js",
    "lint": "tsc -b --noEmit",
    "test": "vitest run --fileParallelism=false --test-timeout=30000",
    "test:integration": "vitest run tests/server.test.ts --run --test-timeout=30000",
    "test:postgres": "vitest run tests/postgres.test.ts --run --test-timeout=60000",
    "eval:notes": "tsx scripts/eval-notes.ts",
    "eval:benchmark": "tsx scripts/run-clinical-benchmark.ts",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:migrate:status": "tsx scripts/migrate.ts status",
    "db:migrate:down": "tsx scripts/migrate.ts down",
    "ops:recovery": "tsx scripts/issue-recovery-token.ts",
    "ops:lockout": "tsx scripts/lockout-account.ts",
    "ops:backup": "sh ./scripts/ops/backup-database.sh",
    "ops:restore": "sh ./scripts/ops/restore-database.sh",
    "prepare": "husky",
    "demo:auth": "tsx scripts/demo/recorder-auth.ts",
    "demo:dentist": "tsx scripts/demo/recorder-dentist.ts",
    "demo:owner": "tsx scripts/demo/recorder-owner.ts",
    "demo:outro": "tsx scripts/demo/recorder-outro.ts",
    "demo:narrate": "tsx scripts/demo/narrator.ts",
    "demo:assemble": "tsx scripts/demo/assemble.ts",
    "demo": "bun run demo:auth && bun run demo:dentist && bun run demo:owner && bun run demo:outro && bun run demo:narrate && bun run demo:assemble",
    "demo:cleanup": "tsx scripts/demo/cleanup.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/kv": "^3.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "pg": "^8.23.0",
    "playwright": "^1.49.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "browserslist": "^4.28.9"
  }
}
