node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

.vercel
.env*

# Compiled server bundle (regenerated by `npm run build`)
server.js

# TypeScript incremental build info
*.tsbuildinfo

# Local data store — patient records, clinician records, audit log, queue state.
# These are runtime data, never source. Committing them publishes patient
# information and PIN hashes; see docs/legal/data-flow-and-subprocessors.md.
# Keep an empty directory so a fresh clone still has somewhere to write. The
# pattern is `data/*` rather than `data/` on purpose: git cannot re-include a file
# whose parent directory is excluded, so `data/` would also swallow `.gitkeep` and
# a fresh clone would have nowhere to write.
data/*
!data/.gitkeep

# Demo/recording artefacts and local exports
demo/out/
*.mp4
!public/demo/dentai-demo.mp4
test-results/
playwright-report/
exports/

# Database dumps (scripts/ops/backup-database.sh). A clinical dump in a repository
# is a breach: they belong in encrypted storage you control, never in git.
backups/
*.dump
*.dump.gz

# Landing-page marketing assets referenced by src/components/Landing.tsx.
assets/*
IDEA.md
tmp-debug-eval.ts

# npm lockfile residue: this repository is Bun-only (package.json comment;
# CI, husky and the preview all use bun.lock). An npm lockfile must never be
# committed — it would silently disagree with bun.lock.
package-lock.json

# Registered git worktrees live under .worktrees/ (e.g. a stale detached
# checkout). Their contents belong to that worktree, never to a release
# commit made from the main checkout.
.worktrees/
