# GEMINI_API_KEY: Hosted Gemini API key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ==============================================================================
# ZERO-COST / OPEN-SOURCE LLM INFERENCE (GROQ / OLLAMA / LLAMA.CPP)
# ==============================================================================
# Use this to generate unlimited, instant, 100% accurate clinical notes without
# hitting Google Gemini quota or billing limits.
#
# Option A: Groq Cloud (Recommended: Free tier, Llama-3.3-70B at 500 tokens/sec)
# Get free API key from https://console.groq.com/keys
# GROQ_API_KEY="gsk_..."
# GROQ_MODEL="llama-3.3-70b-versatile"
#
# Option B: Local Ollama (100% On-Premise, zero external API calls)
# Run `ollama run llama3.1:8b` locally
# OLLAMA_BASE_URL="http://localhost:11434/v1"
# OLLAMA_MODEL="llama3.1:8b"
#
# Option C: Local llama.cpp / llama-server
# Run `llama-server.exe -m model.gguf --port 8080`
# LLAMA_CPP_BASE_URL="http://localhost:8080/v1"
# LLAMA_CPP_MODEL="llama-3.1-8b-instruct"
#
# Provider priority preference ('groq' | 'ollama' | 'llama-cpp' | 'gemini')
# LLM_PROVIDER="groq"
